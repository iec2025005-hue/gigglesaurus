    <light name="competition_sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1 .94 .83 1</diffuse>
      <specular>.7 .7 .7 1</specular>
      <direction>-.4 .3 -.85</direction>
      <cast_shadows>true</cast_shadows>
      <attenuation>
        <range>1000</range>
        <constant>1</constant>
        <linear>0</linear>
        <quadratic>0</quadratic>
      </attenuation>
    </light>
    <model name="arena_floor">
      <static>true</static>
      <pose>0 0 -0.06 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>40 28 0.12</size>
