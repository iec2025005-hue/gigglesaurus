<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="morph_arena">
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>3D View</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
        <engine>ogre2</engine><scene>scene</scene><ambient_light>0.36 0.40 0.47</ambient_light><background_color>0.50 0.64 0.79</background_color>
        <camera_pose>-2 -9 3 0 0.6 0</camera_pose>
      </plugin>
