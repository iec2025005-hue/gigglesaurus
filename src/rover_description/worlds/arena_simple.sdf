<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.8">
  <world name="rover_arena">
    <!-- Optimized Physics Engine for RTF >= 1.0 (Specification Tuned) -->
    <physics name="3ms_fast_ode" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>333</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>25</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>10.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 3D Viewport Camera -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-3.0 -4.5 3.0 0 0.45 0.95</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -1.0</direction>
    </light>

    <!-- Main Ground Plane (40m x 30m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═════════ 40m x 30m ARENA PERIMETER WALLS ═════════ -->
    <model name="arena_perimeter">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>
      <link name="wall_n">
        <pose>0 15 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>40 0.4 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>40 0.4 1.0</size></box></geometry>
          <material><diffuse>0.85 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_s">
        <pose>0 -15 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>40 0.4 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>40 0.4 1.0</size></box></geometry>
          <material><diffuse>0.85 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_e">
        <pose>20 0 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 30 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 30 1.0</size></box></geometry>
          <material><diffuse>0.85 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_w">
        <pose>-20 0 0 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.4 30 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 30 1.0</size></box></geometry>
          <material><diffuse>0.85 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═════════ ZONE 1: INDOOR BLOCK (Narrow Corridors & Thresholds) ═════════ -->
    <!-- Tests Chassis Retraction to Narrow Width (1.5x Corridor) -->
    <model name="indoor_corridor_zone">
      <static>true</static>
      <pose>-12 0 0 0 0 0</pose>
      
      <!-- Floor Plate (Tile appearance) -->
      <link name="indoor_floor">
        <pose>0 0 0.002 0 0 0</pose>
        <visual name="v"><geometry><box><size>12 24 0.004</size></box></geometry>
          <material><diffuse>0.9 0.9 0.92 1</diffuse></material>
        </visual>
      </link>

      <!-- Narrow Corridor 1: Width 0.72m (1.5x robot width) -->
      <link name="corr_wall_left">
        <pose>-0.36 4 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.0 0.8</size></box></geometry>
          <material><diffuse>0.3 0.6 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="corr_wall_right">
        <pose>0.36 4 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 8.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8.0 0.8</size></box></geometry>
          <material><diffuse>0.3 0.6 0.8 1</diffuse></material>
        </visual>
      </link>

      <!-- Corridor 2 with 90 deg Turn: Width 0.96m (2x robot width) -->
      <link name="turn_wall_1">
        <pose>-0.48 -4 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 6.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.0 0.8</size></box></geometry>
          <material><diffuse>0.4 0.7 0.9 1</diffuse></material>
        </visual>
      </link>
      <link name="turn_wall_2">
        <pose>0.48 -4 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.1 6.0 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 6.0 0.8</size></box></geometry>
          <material><diffuse>0.4 0.7 0.9 1</diffuse></material>
        </visual>
      </link>
      <link name="turn_wall_corner">
        <pose>2.5 -7 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>4.0 0.1 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.0 0.1 0.8</size></box></geometry>
          <material><diffuse>0.4 0.7 0.9 1</diffuse></material>
        </visual>
      </link>

      <!-- Indoor Threshold Bumps (10mm, 20mm, cable cover) -->
      <link name="threshold_10mm">
        <pose>0 1 0.005 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.5 0.08 0.010</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.08 0.010</size></box></geometry>
          <material><diffuse>0.95 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
      <link name="threshold_20mm">
        <pose>0 -1 0.010 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.5 0.10 0.020</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.10 0.020</size></box></geometry>
          <material><diffuse>0.95 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═════════ ZONE 2: OFF-ROAD & TERRAIN LADDER ═════════ -->
    <model name="offroad_terrain_block">
      <static>true</static>
      <pose>11 0 0 0 0 0</pose>

      <!-- Slope Ladder: 5°, 10°, 15°, 20°, 25° Incline Ramps -->
      <!-- 5 deg ramp -->
      <link name="ramp_5deg">
        <pose>-4 -8 0.09 0 0.0873 0</pose>
        <collision name="c"><geometry><box><size>2.0 2.0 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 2.0 0.05</size></box></geometry>
          <material><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
      <!-- 10 deg ramp -->
      <link name="ramp_10deg">
        <pose>-1 -8 0.17 0 0.1745 0</pose>
        <collision name="c"><geometry><box><size>2.0 2.0 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 2.0 0.05</size></box></geometry>
          <material><diffuse>0.65 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
      <!-- 15 deg ramp -->
      <link name="ramp_15deg">
        <pose>2 -8 0.26 0 0.2618 0</pose>
        <collision name="c"><geometry><box><size>2.0 2.0 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 2.0 0.05</size></box></geometry>
          <material><diffuse>0.7 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
      <!-- 20 deg ramp -->
      <link name="ramp_20deg">
        <pose>5 -8 0.34 0 0.3491 0</pose>
        <collision name="c"><geometry><box><size>2.0 2.0 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 2.0 0.05</size></box></geometry>
          <material><diffuse>0.75 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
      <!-- 25 deg ramp -->
      <link name="ramp_25deg">
        <pose>8 -8 0.42 0 0.4363 0</pose>
        <collision name="c"><geometry><box><size>2.0 2.0 0.05</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2.0 2.0 0.05</size></box></geometry>
          <material><diffuse>0.8 0.35 0.2 1</diffuse></material>
        </visual>
      </link>

      <!-- 15° Banked Side-Slope Lane (Triggers Active Chassis Expansion) -->
      <link name="side_slope_lane">
        <pose>2 0 0.26 0.2618 0 0</pose>
        <collision name="c"><geometry><box><size>8.0 2.5 0.06</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.0 2.5 0.06</size></box></geometry>
          <material><diffuse>0.85 0.5 0.2 1</diffuse></material>
        </visual>
      </link>

      <!-- Step Ladder (0.25R, 0.5R, 0.75R, 1.0R = 10mm, 20mm, 30mm, 40mm) -->
      <link name="step_10mm">
        <pose>-3 8 0.005 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.5 0.8 0.010</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.8 0.010</size></box></geometry>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
      <link name="step_20mm">
        <pose>-1 8 0.010 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.5 0.8 0.020</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.8 0.020</size></box></geometry>
          <material><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
      <link name="step_30mm">
        <pose>1 8 0.015 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.5 0.8 0.030</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.8 0.030</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
      <link name="step_40mm">
        <pose>3 8 0.020 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.5 0.8 0.040</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 0.8 0.040</size></box></geometry>
          <material><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>

      <!-- Washboard Rumble Track (20-40cm wavelength) -->
      <link name="wb_1"><pose>6 5 0.015 0 1.5708 0</pose><collision name="c"><geometry><cylinder><radius>0.02</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.02</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link>
      <link name="wb_2"><pose>6 5.3 0.015 0 1.5708 0</pose><collision name="c"><geometry><cylinder><radius>0.02</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.02</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link>
      <link name="wb_3"><pose>6 5.6 0.02 0 1.5708 0</pose><collision name="c"><geometry><cylinder><radius>0.025</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.025</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link>
      <link name="wb_4"><pose>6 6.0 0.02 0 1.5708 0</pose><collision name="c"><geometry><cylinder><radius>0.025</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.025</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link>
      <link name="wb_5"><pose>6 6.4 0.025 0 1.5708 0</pose><collision name="c"><geometry><cylinder><radius>0.03</radius><length>3.0</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.03</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.9 0.7 0.1 1</diffuse></material></visual></link>

      <!-- Boulder Field Obstacles -->
      <link name="rock_1"><pose>0 11 0.05 0 0 0</pose><collision name="c"><geometry><sphere><radius>0.06</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.06</radius></sphere></geometry><material><diffuse>0.4 0.4 0.42 1</diffuse></material></visual></link>
      <link name="rock_2"><pose>1.5 11.5 0.04 0 0 0</pose><collision name="c"><geometry><sphere><radius>0.05</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.05</radius></sphere></geometry><material><diffuse>0.4 0.4 0.42 1</diffuse></material></visual></link>
      <link name="rock_3"><pose>-1.2 12 0.07 0 0 0</pose><collision name="c"><geometry><sphere><radius>0.07</radius></sphere></geometry></collision><visual name="v"><geometry><sphere><radius>0.07</radius></sphere></geometry><material><diffuse>0.4 0.4 0.42 1</diffuse></material></visual></link>
      <link name="rock_gap_l"><pose>4 11 0.1 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry><material><diffuse>0.45 0.4 0.35 1</diffuse></material></visual></link>
      <link name="rock_gap_r"><pose>4.8 11 0.1 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.12</radius><length>0.3</length></cylinder></geometry><material><diffuse>0.45 0.4 0.35 1</diffuse></material></visual></link>
    </model>

    <!-- ═════════ ZONE 3: 10m STRAIGHT DRIFT TEST LANE (1m Markers) ═════════ -->
    <model name="test_lane_markers">
      <static>true</static>
      <pose>0 0 0.002 0 0 0</pose>
      <!-- Center driving strip -->
      <link name="lane_strip">
        <pose>0 0 0 0 0 0</pose>
        <visual name="v"><geometry><box><size>2.0 20.0 0.002</size></box></geometry>
          <material><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
      <!-- 10 Markers spaced every 1 meter -->
      <link name="m_0"><pose>1.1 -5 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_1"><pose>1.1 -4 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_2"><pose>1.1 -3 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_3"><pose>1.1 -2 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_4"><pose>1.1 -1 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_5"><pose>1.1 0 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_6"><pose>1.1 1 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_7"><pose>1.1 2 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_8"><pose>1.1 3 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_9"><pose>1.1 4 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
      <link name="m_10"><pose>1.1 5 0.005 0 0 0</pose><visual name="v"><geometry><box><size>0.2 0.05 0.005</size></box></geometry><material><diffuse>1 1 0 1</diffuse></material></visual></link>
    </model>

    <!-- Rover Model Included Directly in World -->
    <include>
      <uri>/home/diya/rover_urdf_ws/src/rover_description/urdf/rover.urdf</uri>
      <name>hex_tele_rover</name>
      <pose>0 0 0.05 0 0 0</pose>
    </include>

  </world>
</sdf>
